# ==============================================================================
# AttendAI: AI-Powered Smart Attendance & Student Engagement System
# Environment Configuration Template (SIH 2026 - PS SIH26205)
# ==============================================================================

# Backend (FastAPI) Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL)
# Local example: postgresql+psycopg2://postgres:postgres@localhost:5432/attendai_db
# Cloud / BaaS example: postgresql+psycopg2://user:password@host.insforge.app:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendai_db

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js) Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="AttendAI - Smart Attendance & Engagement"
NEXT_PUBLIC_SIH_PROBLEM_CODE="SIH26205"

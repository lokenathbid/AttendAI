# AttendAI Backend Environment Variables
PROJECT_NAME="AttendAI Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Host & Port
HOST="0.0.0.0"
PORT=8000

# API Routing
